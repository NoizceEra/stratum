# STRATUM commerce / Solana — copy to .env (never commit .env)

# SPL mint — the real, live STRATUM mint (Token-2022, verified on mainnet-beta
# 2026-09-24; 1% transfer fee is the token's own on-chain config, not something
# this app adds — see src/chain-adapter.js's header). These are also the built-in
# defaults in src/token-config.js now, so this block only needs to exist here for
# anyone who wants to point a fork at a DIFFERENT mint — leave it as-is to use the
# real one. (STRATUM_TOKEN_ADDRESS / STRATUM_CLAIM_TOKEN_ADDR work as aliases.)
STRATUM_TOKEN_MINT=EtCLoVVQ87RfiJELMvcHxf1JwcSP2iNAaL73uacPFaLU
STRATUM_TOKEN_SYMBOL=STRATUM
STRATUM_TOKEN_DECIMALS=6
STRATUM_TOKEN_PLACEHOLDER=false

# Cluster — mainnet-beta. A custom RPC (Helius, Triton, etc.) goes here when the
# public endpoint rate-limits; any https URL works.
STRATUM_CLUSTER=mainnet-beta
STRATUM_SOLANA_RPC=https://api.mainnet-beta.solana.com

# On-chain treasury (PUBLIC address — also in src/token-config.js)
STRATUM_TREASURY_ADDRESS=AYMwwmPxucSXDoc3Qx7prVnH5rP3XpgBDJVENed4A9mo

# Marketplace fee cuts in basis points (250 = 2.5%). Soft in-game resources, not on-chain.
# STRATUM_PARCEL_FEE_BPS=250
# STRATUM_SHOP_FEE_BPS=250

# Wallet-gated exits. Play never charges these. Claim keeps this cut in the
# treasury token account (only the net is transferred). Convert credits the same
# cut to the in-game treasury vault. 10 gold = 1 STRATUM before the convert fee.
# A convert must move at least STRATUM_MIN_CONVERT_AMOUNT gross STRATUM (default 40)
# so a 2.5% fee is a whole token instead of flooring to zero.
# STRATUM_CLAIM_FEE_BPS=250
# STRATUM_CONVERT_FEE_BPS=250
# STRATUM_GOLD_PER_STRM=10
# STRATUM_MIN_CONVERT_AMOUNT=40

# Claim settlement — src/chain-adapter.js has real SPL transfer code (treasury ATA
# -> player ATA via @solana/web3.js + @solana/spl-token, Token-2022-aware). The mint
# is real now, but settlement STILL refuses to run without a signer key (below) —
# see src/chain-adapter.js's isConfigured() and README.md's claim-pipeline section
# for the full gate. Until a signer is set, claims record normally and pending
# balances are untouched; nothing is ever lost, it just doesn't move on-chain yet.
# (STRATUM_CLAIM_RPC_URL / STRATUM_CLAIM_TOKEN_ADDR work as aliases.)
# PRIVATE KEY — local .env only. Never commit. Never paste into chat/logs/notes.
# Accepts the base58 export OR the JSON array; both forms below hold the same key.
# STRATUM_CLAIM_SIGNER_KEY=<base58-secret-here>

# Live Earth Requisition / Structure Rush: spend claimed STRATUM from the
# linked wallet (1% Token-2022 tax, then 80% burned on-chain / 20% treasury).
# The treasury sells half of that 20% into STRATUM/GLDX to fund play claims.
# Leave unset (or 0) for the ledger-only path used by tests.
STRATUM_SINK_ONCHAIN=1

# Minimum pending STRATUM a player must have to claim (protects the treasury's SOL —
# every settled claim is a real fee-paying transaction regardless of size). Default 50.
# STRATUM_MIN_CLAIM_AMOUNT=50

# Shared-world hosting — bind + port. HOST defaults to 0.0.0.0 (all interfaces)
# so LAN peers, tunnels, and hosts like Railway/Fly can reach the world.
# PORT is set for you by most hosts; 8090 is the local default.
# HOST=0.0.0.0
# PORT=8090
# STRATUM_DB=/data/world.db   # persistent volume path on Railway/Fly (keeps data/ local by default)
