# STRATUM commerce / Robinhood Chain — copy to .env (never commit .env)

# Token contract (placeholder until official deploy)
STRATUM_TOKEN_ADDRESS=0x0d0f4c7e2373f2bd67caa2a83d466df2225e4ca7
STRATUM_TOKEN_SYMBOL=STRM
STRATUM_TOKEN_DECIMALS=18
STRATUM_TOKEN_PLACEHOLDER=true

# Chain
STRATUM_CHAIN_ID=4663
STRATUM_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# On-chain treasury (PUBLIC address — also in src/token-config.js)
STRATUM_TREASURY_ADDRESS=0xE8896562619Fe0276d65952b51dcC11C17b8C144

# Marketplace fee cuts in basis points (250 = 2.5%). Soft in-game resources, not on-chain.
# STRATUM_PARCEL_FEE_BPS=250
# STRATUM_SHOP_FEE_BPS=250

# Claim settlement readiness (optional until settlement is implemented)
STRATUM_CLAIM_RPC_URL=https://rpc.mainnet.chain.robinhood.com
STRATUM_CLAIM_TOKEN_ADDR=0x0d0f4c7e2373f2bd67caa2a83d466df2225e4ca7
# PRIVATE KEY — load from Obsidian STRATUM/Treasury-SECRET.md only. Never commit.
# STRATUM_CLAIM_SIGNER_KEY=0x...
