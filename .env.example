# STRATUM commerce / Robinhood Chain — copy to .env (never commit .env)

# Token contract — ⚠️ still the placeholder. The address below is a REAL, unrelated
# already-deployed contract on this chain ("FLIR Technologies", symbol FLIR) — NOT STRM.
# Deploy the real one first: contracts/StratumToken.sol + contracts/README.md. Once
# deployed, set STRATUM_TOKEN_ADDRESS to the real address below (this alone flips
# token-config.js's `placeholder` flag off — see src/token-config.js's withEnv()).
STRATUM_TOKEN_ADDRESS=0x0d0f4c7e2373f2bd67caa2a83d466df2225e4ca7
STRATUM_TOKEN_SYMBOL=STRM
STRATUM_TOKEN_DECIMALS=18
STRATUM_TOKEN_PLACEHOLDER=true

# Chain — verified 2026-09-17: real, reachable EVM chain, chain ID confirmed against the
# live RPC (see README.md's Commerce section). The token contract above is still wrong;
# the chain itself is not.
STRATUM_CHAIN_ID=4663
STRATUM_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# On-chain treasury (PUBLIC address — also in src/token-config.js)
STRATUM_TREASURY_ADDRESS=0xE8896562619Fe0276d65952b51dcC11C17b8C144

# Marketplace fee cuts in basis points (250 = 2.5%). Soft in-game resources, not on-chain.
# STRATUM_PARCEL_FEE_BPS=250
# STRATUM_SHOP_FEE_BPS=250

# Claim settlement — src/chain-adapter.js now has real ERC-20 transfer-signing code (via
# `ethers`, this project's one intentional dependency), but it still refuses to run until
# STRATUM_TOKEN_ADDRESS above points at the real deployed StratumToken, not the FLIR
# placeholder — see src/chain-adapter.js's isConfigured() and README.md's claim-pipeline
# section for the full gate.
STRATUM_CLAIM_RPC_URL=https://rpc.mainnet.chain.robinhood.com
STRATUM_CLAIM_TOKEN_ADDR=0x0d0f4c7e2373f2bd67caa2a83d466df2225e4ca7
# PRIVATE KEY — local .env only. Never commit. Never paste into chat/logs/notes.
# STRATUM_CLAIM_SIGNER_KEY=0x...
